# ── Database (optional) ──
# Prisma SQLite connection string.
# If omitted, the app runs without database features (graceful fallback).
# DATABASE_URL=file:./db/custom.db

# ── FreeLLMAPI (optional) ──
# API key for the AI chat widget.
# Set this to match the API_KEY in your FreeLLMAPI deployment.
# FREE_LLMAPI_KEY=freellmapi-your-key-here

# ── FreeLLMAPI URL (optional) ──
# Base URL of your FreeLLMAPI instance.
# If omitted, the chat widget will attempt to use the default API route.
# FREE_LLMAPI_URL=https://your-freellmapi.vercel.app
